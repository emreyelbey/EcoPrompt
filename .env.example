# Ortam değişkenleri örneği.
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun. .env.local asla git'e girmez.
# Vercel'de aynı değişkenler Project Settings → Environment Variables bölümüne girilir.

# --- Yalnızca sunucu (tarayıcıya asla gitmez) ---

# Yapay zeka API anahtarı
GEMINI_API_KEY=

# Yönetici paneli parolası
ADMIN_PASSCODE=

# Yönetici oturum token'ını imzalamak için uzun, rastgele bir metin (en az 16 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Firebase Admin SDK hizmet hesabı bilgisi (JSON içeriği tek satır olarak)
# DİKKAT: Değeri TEK TIRNAK içine yazın: FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
# Çift tırnakta private_key içindeki \n kaçışları gerçek satır sonuna döner ve JSON'daki çift tırnaklarla çakışır.
FIREBASE_SERVICE_ACCOUNT=

# --- Tarayıcı (yalnızca settings/experiment belgesini okumak için) ---

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
